    {
        "id": "295e1c4a62f2d84d",
        "type": "function",
        "z": "574d042ab3149135",
        "name": "Formatage OPC UA InfluxDB",
        "func": "const valeur = Number(msg.payload);\n\nif (!Number.isFinite(valeur)) {\n    node.warn(\"Valeur OPC UA invalide\");\n    return null;\n}\n\n// Récupère automatiquement le nom de la variable depuis le NodeId\n// Exemple : ns=3;s=StepUp -> StepUp\nconst variable = String(msg.topic || \"\").split(\";s=\")[1] || \"unknown\";\n\n// Timestamp réel fourni par OPC UA\nmsg.timestamp = new Date(msg.sourceTimestamp);\n\nmsg.payload = {\n    fields: {\n        value: valeur\n    },\n    tags: {\n        machine: \"opcplc\",\n        variable: variable\n    }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
