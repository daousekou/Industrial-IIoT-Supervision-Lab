    {
        "id": "50262ff10f6af327",
        "type": "function",
        "z": "574d042ab3149135",
        "name": "Formatage OPC UA TimescaleDB",
        "func": "const valeur = Number(msg.payload);\n\nif (!Number.isFinite(valeur)) {\n    node.warn(\"Valeur OPC UA invalide\");\n    return null;\n}\n\n// Exemple : ns=3;s=StepUp -> StepUp\nconst variable = String(msg.topic || \"\").split(\";s=\")[1] || \"unknown\";\n\n// On utilise le timestamp OPC UA réel\nconst horodatage = new Date(msg.sourceTimestamp).toISOString();\n\nmsg.params = [\n    horodatage,\n    \"opcplc\",\n    variable,\n    valeur\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 340,
