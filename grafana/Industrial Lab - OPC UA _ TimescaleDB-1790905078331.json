      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "État global du labo",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bfzwqti8gwkjkd"
                      },
                      "spec": {
                        "dataset": "industrial_lab",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  CASE\r\n    WHEN\r\n      NOW() - MAX(time) FILTER (WHERE variable = 'StepUp') < INTERVAL '10 seconds'\r\n      AND\r\n      NOW() - MAX(time) FILTER (WHERE variable = 'RandomSignedInt32') < INTERVAL '10 seconds'\r\n    THEN 1\r\n    ELSE 0\r\n  END AS lab_status\r\nFROM mesures_opcua\r\nWHERE variable IN ('StepUp', 'RandomSignedInt32');",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.3",
