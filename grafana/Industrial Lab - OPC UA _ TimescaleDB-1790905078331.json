                      "spec": {
                        "dataset": "industrial_lab",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  COUNT(*) FILTER (WHERE variable = 'StepUp') / 60.0\r\n    AS \"StepUp\",\r\n  COUNT(*) FILTER (WHERE variable = 'RandomSignedInt32') / 60.0\r\n    AS \"RandomSignedInt32\"\r\nFROM mesures_opcua\r\nWHERE time >= NOW() - INTERVAL '1 minute';",
